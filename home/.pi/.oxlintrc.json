{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./tools/oxlint/anti-slop/configs/recommended.json",
    "./tools/oxlint/anti-slop/configs/gleam.json"
  ],
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["tools/oxlint/anti-slop/**"],
  "env": {
    "builtin": true
  }
}
