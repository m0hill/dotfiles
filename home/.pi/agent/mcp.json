{
  "mcpServers": {
    "paper": {
      "url": "http://127.0.0.1:29979/mcp",
      "exposure": "deferred",
      "timeout": 60
    },
    "figma": {
      "url": "https://mcp.figma.com/mcp",
      "oauth": { "scope": "mcp:connect" },
      "exposure": "deferred",
      "timeout": 60
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp",
      "exposure": "deferred",
      "timeout": 60
    },
    "cloudflare-api": {
      "url": "https://mcp.cloudflare.com/mcp",
      "exposure": "deferred",
      "timeout": 60
    },
    "azure": {
      "command": "npx",
      "args": ["-y", "@azure/mcp@latest", "server", "start"],
      "exposure": "deferred",
      "timeout": 60
    }
  }
}
