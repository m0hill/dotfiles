{
  "$schema": "https://opencode.ai/config.json",
  "formatter": false,
  "mcp": {
    "chrome-devtools": {
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "enabled": false,
      "type": "local"
    },
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "grep_app": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.grep.app"
    }
  },
  "permission": {
    "bash": {
      "aws *": "ask",
      "psql *": "ask"
    }
  },
  "plugin": [
    "@plannotator/opencode@latest"
  ]
}