<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.m0hill.codex-gateway</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>set -eu; /bin/mkdir -p "$HOME/Library/Logs"; cd "$HOME/projects/codex-gateway"; exec "$HOME/.local/bin/mise" exec node@24.12.0 -- "$HOME/.nub/bin/nub" run start &gt;&gt; "$HOME/Library/Logs/codex-gateway.log" 2&gt;&gt; "$HOME/Library/Logs/codex-gateway.error.log"</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>CODEX_GATEWAY_HOST</key>
    <string>127.0.0.1</string>
    <key>CODEX_GATEWAY_PORT</key>
    <string>43129</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
