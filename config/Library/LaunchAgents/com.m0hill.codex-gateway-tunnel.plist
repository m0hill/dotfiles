<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.m0hill.codex-gateway-tunnel</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>set -eu; /bin/mkdir -p "$HOME/Library/Logs"; exec "$HOME/.local/bin/mise" exec cloudflared@2026.7.2 -- cloudflared tunnel --config "$HOME/.cloudflared/config.yml" run</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>/Users/mohil/Library/Logs/codex-gateway-tunnel.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/mohil/Library/Logs/codex-gateway-tunnel.error.log</string>
</dict>
</plist>
